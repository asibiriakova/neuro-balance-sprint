# Copy to .env.local to override. All are optional — the defaults match the
# backend's `uv run uvicorn app.main:app --reload` default (localhost:8000)
# and its seeded demo user (see backend/app/store.py).

# Base URL the frontend's HTTP services (services/http-*.ts) call.
VITE_API_BASE_URL=http://localhost:8000/api

# Credentials used to bootstrap a session until the app has a real login
# screen (_docs/tasks.md #3) — must match a user that exists on the backend.
VITE_DEMO_EMAIL=demo@neurosprint.app
VITE_DEMO_PASSWORD=sprint-demo-pw
